<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy for skanaround.bytenetdigital.com -> Node app on 127.0.0.1:3000
  Requires: IIS + URL Rewrite 2.1 + Application Request Routing (ARR).
  Enable the proxy once per server:
    IIS Manager -> server node -> Application Request Routing Cache
      -> Server Proxy Settings -> Enable proxy
  Place this file in the site's physical root (e.g. C:\inetpub\skanaround\web.config).
  Bind HTTPS with a certificate (win-acme / Let's Encrypt) for the domain.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Proxy to Node" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- avatar / attachment uploads -->
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
