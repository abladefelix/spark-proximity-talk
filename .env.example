# Node server (PM2 / ecosystem.config.cjs)
NODE_ENV="production"
HOST="127.0.0.1"
PORT="3000"

# Set to "true" only after android/app/google-services.json exists.
# Without it, Android push registration crashes the app (FirebaseApp not initialized).
VITE_FIREBASE_CONFIGURED=true
