# SKANAROUND — self-hosted environment (copy to .env on the VPS, never commit .env)

# Backend. On the VPS these MUST point at the self-hosted backend
# (e.g. https://api.skanaround.bytenetdigital.com), not the managed one —
# otherwise the deployed app reads and writes the managed database.
SUPABASE_URL="https://YOUR-SELFHOSTED-BACKEND"
SUPABASE_PUBLISHABLE_KEY="YOUR-SELFHOSTED-ANON-KEY"
SUPABASE_PROJECT_ID="selfhosted"

# Server-only. Never expose to the browser. Required by admin/server functions
# (username sign-in, admin console, backups). Must belong to the SAME backend
# as SUPABASE_URL above, or username sign-in fails.
SUPABASE_SERVICE_ROLE_KEY=""

# Baked into the browser bundle at build time — must be set BEFORE `npm run build`,
# and must match SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY exactly.
VITE_SUPABASE_URL="https://YOUR-SELFHOSTED-BACKEND"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-SELFHOSTED-ANON-KEY"
VITE_SUPABASE_PROJECT_ID="selfhosted"

# Node server (PM2 / ecosystem.config.cjs)
NODE_ENV="production"
HOST="127.0.0.1"
PORT="3000"

# Set to "true" only after android/app/google-services.json exists.
# Without it, Android push registration crashes the app (FirebaseApp not initialized).
VITE_FIREBASE_CONFIGURED=true
