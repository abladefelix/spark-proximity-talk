# SKANAROUND — self-hosted environment (copy to .env on the VPS, never commit .env)

# Backend (Supabase). Values come from your Supabase project settings.
SUPABASE_URL="https://pxgxxlcchyxrilibecsc.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_5yFOmqzRzVQomGndIqalgg_eLTCBTgO"
SUPABASE_PROJECT_ID="pxgxxlcchyxrilibecsc"

# Server-only. Never expose to the browser. Required by admin/server functions.
