# Baked into the browser bundle at build time — must be set BEFORE `npm run build`.
VITE_SUPABASE_URL="https://pxgxxlcchyxrilibecsc.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_5yFOmqzRzVQomGndIqalgg_eLTCBTgO"
